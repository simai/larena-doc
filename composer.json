{
    "authors": [
        {
            "name": "Rim Zabarov",
            "homepage": "https://github.com/zabarov",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "simai/docara": "^3.0.2"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/simai/docara.git"
        }
    ],
    "scripts": {
        "docs:status": "@php scripts/documentation-impact.php status",
        "docs:impact": "@php scripts/documentation-impact.php impact",
        "docs:engine:status": "@php scripts/docara-release-status.php",
        "docs:engine:check": "@php scripts/docara-release-status.php --require-current",
        "docs:source:check": "@php scripts/documentation-impact.php source-contract",
        "docs:source:write": "@php scripts/documentation-impact.php source-contract --write",
        "docs:test": [
            "@php tests/documentation-impact-test.php",
            "@php tests/docara-release-status-test.php"
        ],
        "docs:check": [
            "@docs:test",
            "@docs:engine:check",
            "@php scripts/documentation-impact.php check --require-docara"
        ]
    }
}
